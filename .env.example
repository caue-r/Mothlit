# Configuração NÃO sensível do Mothlit.
# O `python -m mothlit setup` grava isto em %APPDATA%\Mothlit\.env.
# Um .env na pasta atual tem prioridade (útil no desenvolvimento).
# Segredos (local_key da lâmpada, token SmartThings) ficam no keyring, nunca aqui.

# Lâmpada Tuya (valores do `python -m tinytuya wizard` / `scan`)
LAMPADA_ID=
LAMPADA_IP=192.168.1.34
LAMPADA_VERSAO=3.5
LAMPADA_NOME=Lâmpada

# Ar-condicionado (deviceId na SmartThings)
SMARTTHINGS_DEVICE_ID=
