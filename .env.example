# NON-sensitive Mothlit configuration.
# `python -m mothlit setup` writes this to %APPDATA%\Mothlit\.env.
# A .env in the current folder takes priority (handy during development).
# Secrets (the lamp's local_key, the SmartThings token) live in the keyring, never here.

# Tuya lamp (values from `python -m tinytuya wizard` / `scan`)
LAMP_ID=
LAMP_IP=192.168.1.34
LAMP_VERSION=3.5
LAMP_NAME=Lamp

# Air conditioner (deviceId on SmartThings)
SMARTTHINGS_DEVICE_ID=
